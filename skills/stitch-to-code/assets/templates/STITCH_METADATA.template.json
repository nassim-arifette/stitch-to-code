      "screenId": "[STITCH_SCREEN_ID]",
      "canonicalId": null,
      "supersededBy": null,
      "retrievedAt": "[ISO-8601]",
      "artifacts": {
        "html": {
          "path": "",
          "sha256": "",
          "bytes": 0
        },
        "png": {
          "path": "",
          "sha256": "",
          "bytes": 0,
          "width": 0,
          "height": 0
        }
      },
      "notes": []
    }
  ],
  "archivePolicy": {
    "directoryPattern": ".stitch/archive/YYYY-MM-DD--project-slug--projectId",
    "archiveBeforeCleanup": true
  }
